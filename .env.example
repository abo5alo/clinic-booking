# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Plain HTTP on localhost; keep 1 (the default) behind HTTPS in production.
DJANGO_SSL_REDIRECT=0
DJANGO_TIME_ZONE=UTC
DJANGO_NUM_PROXIES=0

POSTGRES_DB=clinic
POSTGRES_USER=clinic
POSTGRES_PASSWORD=
